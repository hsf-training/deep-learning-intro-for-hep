# Images that _config.yml copies to the site root (sphinx html_extra_path), so
# the pages link to them without the img/ prefix. The book build checks them.
^file://.*/deep-learning-intro-for-hep/(tensorflow-playground|ups-and-downs-of-ai-3-overlay|distill-momentum|playground-solution-circle-[12]|ridiculously-overfitted)\.png$
^file://.*/deep-learning-intro-for-hep/better-boy-wolf-[1-4]\.jpg$

